# Tests for Run-End Encoded (REE) array support in aggregations
# This tests that REE arrays can be used as GROUP BY keys (requires proper hashing support)

# Create a table with REE-encoded sensor IDs using arrow_cast
# First create primitive arrays, then cast to REE in a second step
statement ok
CREATE TABLE sensor_readings AS
WITH raw_data AS (
  SELECT * FROM (
    VALUES
      ('sensor_A', 22),
      ('sensor_A', 23),
      ('sensor_B', 20),
      ('sensor_A', 24)
  ) AS t(sensor_id, temperature)
)
SELECT
  arrow_cast(sensor_id, 'RunEndEncoded("run_ends": non-null Int32, "values": Utf8)') AS sensor_id,
  temperature
FROM raw_data;

# Test basic aggregation with REE column as GROUP BY key
query ?RI rowsort
SELECT
    sensor_id,
    AVG(temperature) AS avg_temp,
    COUNT(*) AS reading_count
FROM sensor_readings
GROUP BY sensor_id;
----
sensor_A 23 3
sensor_B 20 1

# Test DISTINCT with REE column
query ? rowsort
SELECT DISTINCT sensor_id
FROM sensor_readings;
----
sensor_A
sensor_B

# Test arithmetic on REE columns (numeric and decimal value types)
query IR rowsort
SELECT
    arrow_cast(temperature, 'RunEndEncoded("run_ends": non-null Int32, "values": Int64)') + 1 AS t_plus_one,
    arrow_cast(arrow_cast(temperature, 'Decimal128(10, 2)'), 'RunEndEncoded("run_ends": non-null Int32, "values": Decimal128(10, 2))') + 1 AS t_dec_plus_one
FROM sensor_readings;
----
21 21
23 23
24 24
25 25

# Regex / LIKE match against an REE column whose values are themselves Dictionary-encoded
query BB rowsort
SELECT
    arrow_cast(
        arrow_cast(sensor_id, 'Dictionary(UInt32, Utf8)'),
        'RunEndEncoded("run_ends": non-null Int32, "values": Dictionary(UInt32, Utf8))'
    ) ~ 'sensor_A',
    arrow_cast(
        arrow_cast(sensor_id, 'Dictionary(UInt32, Utf8)'),
        'RunEndEncoded("run_ends": non-null Int32, "values": Dictionary(UInt32, Utf8))'
    ) LIKE 'sensor_A'
FROM sensor_readings;
----
false false
true true
true true
true true

# date_bin's signature is a plain Timestamp, not RunEndEncoded, so this only
# plans if coerced_from() unwraps the REE value type the same way it does for
# Dictionary (see test_coerced_from_run_end_encoded)
statement ok
CREATE TABLE ree_timestamps AS
SELECT
    arrow_cast(
        arrow_cast(ts, 'Timestamp(Nanosecond, None)'),
        'RunEndEncoded("run_ends": non-null Int32, "values": Timestamp(Nanosecond, None))'
    ) AS ts
FROM (VALUES
    ('2023-12-04T00:00:00'),
    ('2023-12-04T00:05:00'),
    ('2023-12-04T00:35:00')
) AS t(ts);

query P rowsort
SELECT date_bin('30 minutes', ts) FROM ree_timestamps;
----
2023-12-04T00:00:00
2023-12-04T00:00:00
2023-12-04T00:30:00

# RANGE window frame ordered by an REE-encoded column: extract_window_frame_target_type()
# unwraps RunEndEncoded the same way it does for Dictionary, so a frame that
# doesn't need offset arithmetic.
query II
SELECT
    temperature,
    SUM(temperature) OVER (
        ORDER BY arrow_cast(
            temperature,
            'RunEndEncoded("run_ends": non-null Int32, "values": Int64)'
        )
        RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS windowed_sum
FROM sensor_readings
ORDER BY temperature;
----
20 20
22 42
23 65
24 89

# An offset RANGE bound (`k PRECEDING`/`k FOLLOWING`, unlike CURRENT ROW or
# UNBOUNDED above) is computed by adding/subtracting the offset from the
# current row's value, and arrow's numeric kernels don't support arithmetic
# on a still-RunEndEncoded-wrapped value (tracked at
# https://github.com/apache/arrow-rs/issues/10891).
query error RANGE with offset PRECEDING/FOLLOWING is not supported for ORDER BY type
SELECT
    temperature,
    SUM(temperature) OVER (
        ORDER BY arrow_cast(
            temperature,
            'RunEndEncoded("run_ends": non-null Int32, "values": Int64)'
        )
        RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING
    ) AS windowed_sum
FROM sensor_readings
ORDER BY temperature;

# MIN / MAX over REE columns go through the same planning path as SQL users hit,
# so the coerced argument type comes from get_min_max_result_type.
statement ok
CREATE TABLE ree_readings AS
SELECT
  sensor_id,
  arrow_cast(arrow_cast(temperature, 'UInt32'), 'RunEndEncoded("run_ends": non-null Int32, "values": UInt32)') AS temp_u32
FROM sensor_readings;

# Ungrouped MIN / MAX over a REE integer column
query II
SELECT MIN(temp_u32), MAX(temp_u32) FROM ree_readings;
----
20 24

# MIN / MAX return the REE column's value type, as they do for Dictionary
query TT
SELECT arrow_typeof(MIN(temp_u32)), arrow_typeof(MAX(temp_u32)) FROM ree_readings;
----
UInt32 UInt32

# Grouped MIN / MAX over a REE integer column
query ?II rowsort
SELECT sensor_id, MIN(temp_u32), MAX(temp_u32)
FROM ree_readings
GROUP BY sensor_id;
----
sensor_A 22 24
sensor_B 20 20

# MAX as a window function over a REE column
query ?I rowsort
SELECT sensor_id, MAX(temp_u32) OVER (PARTITION BY sensor_id)
FROM ree_readings;
----
sensor_A 24
sensor_A 24
sensor_A 24
sensor_B 20

# MIN / MAX over a REE column whose values are Dictionary-encoded
query TT
SELECT MAX(arrow_cast(arrow_cast(sensor_id, 'Dictionary(UInt32, Utf8)'),
         'RunEndEncoded("run_ends": non-null Int32, "values": Dictionary(UInt32, Utf8))')),
       arrow_typeof(MAX(arrow_cast(arrow_cast(sensor_id, 'Dictionary(UInt32, Utf8)'),
         'RunEndEncoded("run_ends": non-null Int32, "values": Dictionary(UInt32, Utf8))')))
FROM sensor_readings;
----
sensor_B Utf8

statement ok
DROP TABLE ree_readings;

# LIKE keeps an outer REE layer over Utf8 or dictionary-encoded Utf8.
# A dictionary around REE or another dictionary still requires coercion.
statement ok
CREATE TABLE ree_strings AS
SELECT id,
       arrow_cast(value, 'RunEndEncoded("run_ends": non-null Int32, "values": Dictionary(UInt32, Utf8))') AS value,
       arrow_cast(value, 'RunEndEncoded("run_ends": non-null Int32, "values": Utf8)') AS plain_value,
       arrow_cast(arrow_cast(value, 'Dictionary(UInt32, Utf8)'),
         'Dictionary(UInt32, RunEndEncoded("run_ends": non-null Int32, "values": Utf8))') AS dict_run,
       arrow_cast(arrow_cast(value, 'Dictionary(UInt32, Utf8)'),
         'Dictionary(UInt32, Dictionary(UInt32, Utf8))') AS dict_dict,
       pattern
FROM (VALUES
    (1, 'Ab_c', '%b\_%'),
    (2, 'Ab_c', 'a%'),
    (3, 'Äpfel', 'ä%'),
    (4, NULL, '%'),
    (5, 'Other', NULL)
) AS t(id, value, pattern);

query IBBBBBBBB
SELECT id, value LIKE '%b\_%', value NOT LIKE '%b\_%',
       value ILIKE 'ä%', value NOT ILIKE 'ä%',
       plain_value LIKE '%b\_%', plain_value NOT LIKE '%b\_%',
       plain_value ILIKE 'ä%', plain_value NOT ILIKE 'ä%'
FROM ree_strings ORDER BY id;
----
1 true false false true true false false true
2 true false false true true false false true
3 false true true false false true true false
4 NULL NULL NULL NULL NULL NULL NULL NULL
5 false true false true false true false true

query TT
EXPLAIN SELECT id FROM ree_strings WHERE value ILIKE '%b\_%';
----
logical_plan
01)Projection: ree_strings.id
02)--Filter: ree_strings.value ILIKE Utf8("%b\_%")
03)----TableScan: ree_strings projection=[id, value]
physical_plan
01)FilterExec: value@1 ILIKE %b\_%, projection=[id@0]
02)--DataSourceExec: partitions=1, partition_sizes=[1]

query I
SELECT id FROM ree_strings WHERE value ILIKE '%b\_%' ORDER BY id;
----
1
2

query IBBBB
SELECT id, value ILIKE pattern, plain_value ILIKE pattern,
       dict_run ILIKE pattern, dict_dict ILIKE pattern
FROM ree_strings ORDER BY id;
----
1 true true true true
2 true true true true
3 true true true true
4 NULL NULL NULL NULL
5 NULL NULL NULL NULL

query TT
EXPLAIN SELECT value ILIKE pattern, plain_value ILIKE pattern,
               dict_run ILIKE pattern, dict_dict ILIKE pattern
FROM ree_strings;
----
logical_plan
01)Projection: ree_strings.value ILIKE ree_strings.pattern, ree_strings.plain_value ILIKE ree_strings.pattern, CAST(ree_strings.dict_run AS Utf8) ILIKE ree_strings.pattern, CAST(ree_strings.dict_dict AS Utf8) ILIKE ree_strings.pattern
02)--TableScan: ree_strings projection=[value, plain_value, dict_run, dict_dict, pattern]
physical_plan
01)ProjectionExec: expr=[value@0 ILIKE pattern@4 as ree_strings.value ILIKE ree_strings.pattern, plain_value@1 ILIKE pattern@4 as ree_strings.plain_value ILIKE ree_strings.pattern, CAST(dict_run@2 AS Utf8) ILIKE pattern@4 as ree_strings.dict_run ILIKE ree_strings.pattern, CAST(dict_dict@3 AS Utf8) ILIKE pattern@4 as ree_strings.dict_dict ILIKE ree_strings.pattern]
02)--DataSourceExec: partitions=1, partition_sizes=[1]

# Nested dictionaries keep their existing coercion for all four operators.
query IBBBBBBBB
SELECT id, dict_run LIKE '%b\_%', dict_run NOT LIKE '%b\_%',
       dict_run ILIKE 'ä%', dict_run NOT ILIKE 'ä%',
       dict_dict LIKE '%b\_%', dict_dict NOT LIKE '%b\_%',
       dict_dict ILIKE 'ä%', dict_dict NOT ILIKE 'ä%'
FROM ree_strings ORDER BY id;
----
1 true false false true true false false true
2 true false false true true false false true
3 false true true false false true true false
4 NULL NULL NULL NULL NULL NULL NULL NULL
5 false true false true false true false true

# A different pattern layout must still coerce the REE operand's values.
query IBB
SELECT id, value ILIKE arrow_cast(pattern, 'LargeUtf8'),
       value ILIKE arrow_cast(pattern, 'Utf8View')
FROM ree_strings ORDER BY id;
----
1 true true
2 true true
3 true true
4 NULL NULL
5 NULL NULL

query TT
EXPLAIN SELECT value ILIKE arrow_cast('a%', 'LargeUtf8') FROM ree_strings;
----
logical_plan
01)Projection: CAST(ree_strings.value AS LargeUtf8) ILIKE LargeUtf8("a%") AS ree_strings.value ILIKE arrow_cast(Utf8("a%"),Utf8("LargeUtf8"))
02)--TableScan: ree_strings projection=[value]
physical_plan
01)ProjectionExec: expr=[CAST(value@0 AS LargeUtf8) ILIKE a% as ree_strings.value ILIKE arrow_cast(Utf8("a%"),Utf8("LargeUtf8"))]
02)--DataSourceExec: partitions=1, partition_sizes=[1]

# SIMILAR TO uses the regex kernel, which still needs decoded strings.
query IB
SELECT id, value SIMILAR TO 'Ab_c' FROM ree_strings ORDER BY id;
----
1 true
2 true
3 false
4 NULL
5 false

query TT
EXPLAIN SELECT value SIMILAR TO 'Ab_c' FROM ree_strings;
----
logical_plan
01)Projection: CAST(ree_strings.value AS Utf8) SIMILAR TO Utf8("Ab_c")
02)--TableScan: ree_strings projection=[value]
physical_plan
01)ProjectionExec: expr=[CAST(value@0 AS Utf8) ~ Ab_c as ree_strings.value SIMILAR TO Utf8("Ab_c")]
02)--DataSourceExec: partitions=1, partition_sizes=[1]

statement ok
DROP TABLE ree_strings;
